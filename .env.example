# Visual review (Agentation + tmux) — local `npm run dev` only; production build ignores it.
# 1 = show the Agentation toolbar and the "Claude" panel. ENDPOINT = agentation-mcp HTTP server (started automatically by `npm run dev`).
# PATH = optional single pathname with the toolbar (empty = every page).
VITE_VISUAL_REVIEW=
VITE_AGENTATION_ENDPOINT=http://localhost:4748
VITE_VISUAL_REVIEW_PATH=
# tmux pane running Claude Code (inside it: `echo $TMUX_PANE`, e.g. %43). The panel types messages into it.
AGENTATION_TMUX_PANE=
